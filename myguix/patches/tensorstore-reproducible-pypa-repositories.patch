+def remove_pip_installation_artifacts():
+  # Bazel uses console_scripts_for_bazel instead of pip's launchers, whose
+  # shebangs and RECORD checksums capture the build interpreter's path.
+  scripts = pathlib.Path("bin")
+  if scripts.exists():
+    shutil.rmtree(scripts)
+  for record in pathlib.Path(".").glob("*.dist-info/RECORD"):
+    record.unlink()
